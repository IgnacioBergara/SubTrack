# Copiar a .env y ajustar. Credenciales solo para el Postgres local de docker-compose.

# Base de desarrollo (schema public)
DATABASE_URL="postgresql://subtrack:subtrack@localhost:5432/subtrack?schema=public"

# Base de tests de integración (schema aparte, se vacía entre tests)
TEST_DATABASE_URL="postgresql://subtrack:subtrack@localhost:5432/subtrack?schema=test"
